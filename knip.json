{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/storage/*/index.ts!",
    "src/embeddings/*/index.ts!",
    "src/vector/*/index.ts!",
    "src/keys/*/index.ts!",
    "src/integrations/*/index.ts!",
    "src/retrievers/*/index.ts!",
    "src/searchers/*/index.ts!",
    "src/ingestors/*/index.ts!"
  ],
  "project": ["src/**/*.ts!"],
  "ignoreExportsUsedInFile": true,
  // devDeps that mirror the optional peerDependencies. Nothing imports them by name —
  // `requireFromPlugins` resolves them at runtime — but they must stay installed so the
  // suite can exercise the HNSW index, the re2 searchers and LAN pairing.
  "ignoreDependencies": [
    "hnswlib-node",
    "re2",
    "bonjour-service"
  ]
}
